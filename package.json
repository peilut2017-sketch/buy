{
  "name": "smartbuy",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p supabase/functions/tsconfig.json",
    "lint:rtl": "node scripts/check-logical-css.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "build:ext": "pnpm --filter @smartbuy/extension build",
    "e2e": "node tests/e2e/build.mjs && node tests/e2e/run.mjs",
    "check": "pnpm test && pnpm typecheck && pnpm lint:rtl && pnpm check:manifest",
    "build:web": "pnpm --filter @smartbuy/web build",
    "e2e:web": "node tests/e2e/build-web.mjs && node tests/e2e/web.mjs"
  },
  "devDependencies": {
    "@hebcal/core": "^5.10.1",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "postgres": "^3.4.9",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
