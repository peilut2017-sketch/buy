# Copy to .env (never commit it). The anon key is public by design; the service role key must never be here.
WXT_SUPABASE_URL=
WXT_SUPABASE_ANON_KEY=
# The public website. Leave empty until the domain is chosen: links and the uninstall survey are then hidden, not invented.
WXT_WEBSITE_URL=
# Trial only: set to 1 to show an email + password sign-in (accounts are created by hand in the Supabase dashboard).
# Leave empty for any build other people will use.
WXT_TRIAL_PASSWORD_LOGIN=
